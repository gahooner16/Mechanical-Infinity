	quest.2BEE61D5EA111F5B.quest_desc: [
		"Energy cables do exactly as they sound, they transfer power."
		""
		"At nitro they are one of the best, and they are also great for tps."
	]
	quest.2BEE61D5EA111F5B.quest_subtitle: "Wired Powah!"
	quest.2CB4A101005B075E.quest_desc: [
		"Next up are Niotic Crystals, made with 1 Diamond."
		""
		"This block craft costs 1 Block of Diamond."
	]
	quest.2CB4A101005B075E.quest_subtitle: "Tier 4"
	quest.3037A7B311DA0740.quest_desc: [
		"Your almost there! Spirited crystals are tier 4, made with 1 Emerald."
		""
		"As you may have guessed, it can also be made in block form with one Emerald Block."
	]
	quest.3037A7B311DA0740.quest_subtitle: "Tier 5"
	quest.3209C3A0AB8A3749.quest_desc: [
		"There are Gateways that allow you to summon the bosses from these mods:"
		""
		"&l&9TWILIGHT FOREST"
		"&l&bCATACLYSM"
		""
		"See Gateways quest page for more."
	]
	quest.325D534AA901917B.quest_desc: ["You need Oxygen From an Electrolytic Seperator."]
	quest.35179C553FED0B87.quest_desc: [
		"The Reactor is the best power generator in Powah."
		""
		"It runs on uraninite, which is most easily made in the energizing orb using."
		""
		"For the best results you can feed it Redstone, Coal, Water, and a solid coolant. The water is not consumed."
	]
	quest.35179C553FED0B87.quest_subtitle: "Active Power"
	quest.37D7B504F2EF66B1.quest_desc: ["Shift right clicking me with an iron shovel gives you 5 earth essence!"]
	quest.37EC8847643485B3.quest_desc: [
		"To use Powah's unique crafting system you need a Energizing Orb and at least one Energizing Rod (although it is recommended to make more)."
		""
		"Start with Basic Energizing Rods and place it/them on any power cable, then place your energizing orb nearby. "
		""
		"Right click the orb with your items and wait for it to craft. "
	]
	quest.37EC8847643485B3.quest_subtitle: "Energizing!"
	quest.395CCB71A707A74A.quest_desc: [
		"Shift-right click dirt for 1 earth essence"
		"Shift right click Rich Soil for 2"
	]
	quest.398687F801DD233F.quest_desc: ["This is made with Lava, Hydrogen, and 10 Metallic Essence and is used to grow Iron Seeds in a Planting Station"]
