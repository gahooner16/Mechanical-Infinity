	quest.4D33D9FAAE828603.quest_desc: [
		"Many mods come with their own wrench, and this one too!"
		""
		"The Wrench has 3 modes:"
		""
		"Config Mode: used to change Cables I/0 configuration."
		""
		"Link Mode: used to link linkable blocks like Energizing Orbs and Rods."
		""
		"Rotate Mode: used to rotate blocks horizontally."
		""
		"Change mode with shift + right-click."
	]
	quest.4DC6CB201C92587C.quest_desc: [
		"The Battery is exactly what it sounds like, a battery."
		""
		"It provides power to any item in your inventory that requires it until the battery is empty."
		""
		"Shift right click with it to activate."
	]
	quest.4DC6CB201C92587C.quest_subtitle: "Powah Storage!"
	quest.4F41E02BBB8D4123.quest_desc: [
		"Do I even need to explain this one?"
		"Its a solar panel."
	]
	quest.4F41E02BBB8D4123.quest_subtitle: "Passive Powah!"
	quest.50402B3043E98F05.quest_desc: ["This is for focus"]
	quest.50402B3043E98F05.quest_subtitle: "Hi."
	quest.50ED5BE6490F83F0.quest_desc: [
		"The ender gate, when paired with the Ender Cell, allows you acess to wireless power."
		""
		"Simply place it on your machine and it will start to transfer power!"
		""
		"If needed you can right click it to acess the gui."
	]
	quest.50ED5BE6490F83F0.quest_subtitle: "Wireless Powah!"
	quest.553591401070D386.title: "Ore to Dust"
	quest.576ACB07185AA060.quest_desc: [
		"The final and best tier of material, Nitro Crystals are also the hardest to make."
		""
		"To make them you need a block of blazing cystal, 2 redstone blocks, and a nether star."
		""
		"The craft makes 16 but there is also a block recipe that takes a nether star block, 1 1x compressed block of redstone, and 4 blocks of blazing crystal to makes 8 Blocks of Nitro Crystal."
	]
	quest.576ACB07185AA060.quest_subtitle: "Tier 6"
	quest.591C86F0FFA2D111.quest_desc: [
		"Bone hammer gives 1 metallic essence"
