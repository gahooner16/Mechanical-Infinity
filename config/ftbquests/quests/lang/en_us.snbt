	quest.3A1C936F19145E5F.quest_subtitle: "Charging!"
	quest.425768712B4346A7.quest_desc: [
		"Blazing Crystals are the third stage, made with either 1 Blaze Rod or 4 Blaze Powder."
		""
		"This also has a block craft with 4 Blaze Meshes. "
	]
	quest.425768712B4346A7.quest_subtitle: "Tier 3"
	quest.44AE4403A7AD3A2D.quest_desc: [
		"Eventually you will probably want to set up autocrafting for the energizing orb."
		""
		"The easiest way is with ae2 pattern providers."
		""
		"Since the orb requires exact input and will still accept items after it is filled, you can only input one craft at a time."
		""
		"To do so with ae2, simply set the pattern provider to blocking mode using the button in the upper left hand corner."
	]
	quest.44AE4403A7AD3A2D.quest_subtitle: "Easiest with AE2"
