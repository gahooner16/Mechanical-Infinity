	quest.170E581CD2744500.quest_desc: [
		"&l&aREPLICATOR"
		""
		"The Replicator prints blocks/items from matter stored in the Matter Tanks, it requires that the blocks/items be learned in a Memory Chip and put in a Chip Storage."
		""
		"&l&1MEMORY CHIP"
		""
		"A Chip that learns blocks/items when inside an Identification Chamber, Once blocks/items are learned the chip must be placed in a chip storage."
		""
		"&l&5IDENTIFICATION"
		""
		"A block that is used to learn blocks/items to a Memory Chip."
		""
		"&l&4DISENTIGRATION"
		""
		"A device used to destroy blocks/items and add matter value to your Matter Tanks."
		""
		"See Replication quest page for more."
	]
	quest.170E581CD2744500.quest_subtitle: "Replication Explanition"
	quest.1725FE520BE6765E.quest_desc: [
		"The Ender Cell, when used with the Ender Gates, allows cross-dimensional wireless power."
		""
		"They have 12 different channels that can be used."
		""
		"Channels initially have no power storage, simply shift-click any Powah Battery / Energy Cell from your inventory and your good to go!"
	]
	quest.1725FE520BE6765E.quest_subtitle: "Wireless Powah!"
	quest.17774B524B631757.quest_desc: ["Combining Water, Oxygen, and an Earth Essence in a pressurized reaction chamber makes Tier 1 Growth Solution, which lets you grow Earth Seeds!"]
	quest.18D72812D63A313D.quest_desc: ["Hay bales are a faster way to get Organic Matter."]
	quest.1B6C7E865E64BD29.quest_desc: ["This is made in the Particle Accelerator from Oritech using one Earth Essence and one Metallic Essence."]
	quest.1BEE6A25B4AEE069.quest_desc: [
		"Powah is a very powerful mod for early-to-midgame power generation."
		""
		"You are going to need alot of Dielectric Paste."
	]
	quest.1BEE6A25B4AEE069.title: "Start of the Powah Quest Line !"
	quest.24DE6113062A3493.quest_desc: ["This is made with Turbofuel, Carbon, and one Ender Essence and is used to grow End Seeds in a Planting Station"]
	quest.256C4C8944298576.quest_desc: ["A faster way to disentigrate Earth."]
	quest.290A4E366BE7FC72.quest_desc: ["Nether seeds are grown nearly the same as Earth, but with Tier 3 Growth Solution. That costs Biofuel and Refined Obsidian with 1 Nether Essence in the Pressurized Reaction Chamber."]
