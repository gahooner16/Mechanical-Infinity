	quest.044A68E2B86F37ED.quest_desc: [
		"With 12 End Portal Frames and 12 Eyes of Ender, you can make your very own End Portal! However, The only thing in the End is just the Dragon Fight, so dont go there expecting loot!"
		""
		"&4&lBE CAREFUL, THE END PORTAL FRAMES CAN NOT BE BROKEN ONCE PLACED"
	]
	quest.044A68E2B86F37ED.title: "The End!"
	quest.059B3E88794222B2.quest_desc: [
		"The Thermo generator is great for early game power."
		""
		"To run it, place a heat source underneath and pipe in water."
		""
		"Heat sources are :"
		"Magma blocks 800°C = x0.8"
		"Lava 1000°C = x1.0"
		"Block of Blazing Crystal 2800°C = x2.8"
	]
	quest.059B3E88794222B2.quest_subtitle: "Passive Powah"
